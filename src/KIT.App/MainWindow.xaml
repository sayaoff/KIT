<Window x:Class="KIT.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KIT Alpha" Width="1060" Height="720" MinWidth="900" MinHeight="620"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="NavigationItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Padding="14,10" CornerRadius="{DynamicResource ControlCornerRadius}" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectedBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HiddenTabs" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="SettingChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChoiceBorder" Padding="16" CornerRadius="{DynamicResource CardCornerRadius}"
                                Background="{DynamicResource InsetBackground}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background" Value="{DynamicResource HoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background" Value="{DynamicResource SelectedBackground}" />
                                <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="12,0">
                    <TextBlock Text="KIT" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="ALPHA" Margin="1,2,0,0" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryText}" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <RadioButton x:Name="HomeNavigation" GroupName="Navigation" IsChecked="True"
                                 Style="{StaticResource NavigationItem}" Tag="0"
                                 Content="{DynamicResource HomeTab}" Checked="Navigation_Checked" />
                    <RadioButton x:Name="KitsNavigation" GroupName="Navigation"
                                 Style="{StaticResource NavigationItem}" Tag="1"
                                 Content="{DynamicResource KitsTab}" Checked="Navigation_Checked" />
                    <RadioButton x:Name="SessionsNavigation" GroupName="Navigation"
                                 Style="{StaticResource NavigationItem}" Tag="2"
                                 Content="{DynamicResource SessionsTab}" Checked="Navigation_Checked" />
                    <RadioButton x:Name="SettingsNavigation" GroupName="Navigation"
                                 Style="{StaticResource NavigationItem}" Tag="3"
                                 Content="{DynamicResource SettingsTab}" Checked="Navigation_Checked" />
                </StackPanel>

                <StackPanel Grid.Row="4">
                    <TextBlock Text="{DynamicResource LanguageLabel}" Margin="12,0,0,7" FontSize="11"
                               Foreground="{DynamicResource SecondaryText}" />
                    <Button x:Name="LanguageToggleButton" Click="LanguageToggle_Click"
                            HorizontalContentAlignment="Left" Padding="12,8" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="82" />
                <RowDefinition Height="*" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="PageTitle" Margin="32,28,32,0" FontSize="22" FontWeight="SemiBold"
                       Text="{DynamicResource HomeTab}" />

            <TabControl x:Name="MainTabs" Grid.Row="1" Style="{StaticResource HiddenTabs}"
                        Background="Transparent" Foreground="{DynamicResource PrimaryText}" BorderThickness="0">
                <TabItem>
                    <Grid Margin="32,0,32,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border x:Name="FirstRunPanel" Style="{StaticResource SectionCard}" Margin="0,0,0,14"
                                BorderBrush="{DynamicResource Accent}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="{DynamicResource FirstRunTitle}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource FirstRunDescription}" Margin="0,5,0,12"
                                               Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{DynamicResource FirstRunSteps}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{DynamicResource FirstRunStart}" Click="SelectExecutable_Click"
                                        Padding="17,9" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource SectionCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,28,0">
                                    <TextBlock Text="{DynamicResource ActiveKitEyebrow}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryText}" />
                                    <TextBlock x:Name="HomeActiveKitNameText" Margin="0,5,0,0" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock x:Name="HomeKitSummaryText" Margin="0,5,0,0"
                                               Foreground="{DynamicResource SecondaryText}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,17,0,0">
                                        <TextBlock Text="Counter-Strike 2" FontWeight="SemiBold" />
                                        <TextBlock Text="  ·  " Foreground="{DynamicResource SecondaryText}" />
                                        <TextBlock x:Name="ExecutablePathText" Text="{DynamicResource NoExecutable}"
                                                   MaxWidth="520" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource SecondaryText}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock x:Name="HomeGameStateText" HorizontalAlignment="Right" FontSize="11"
                                               Foreground="{DynamicResource SecondaryText}" />
                                    <Button Content="{DynamicResource EditKit}" Click="EditActiveKit_Click"
                                            Padding="16,8" Margin="0,12,0,0" />
                                    <Button x:Name="SelectExecutableButton" Content="{DynamicResource SelectCs2}"
                                            Click="SelectExecutable_Click" Padding="16,7" Margin="0,7,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <UniformGrid Grid.Row="3" Columns="3">
                            <Border Style="{StaticResource SectionCard}" Margin="0,0,10,0">
                                <StackPanel><TextBlock Text="{DynamicResource LastSession}" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                    <TextBlock x:Name="LastSessionDurationText" Margin="0,7,0,0" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="LastSessionDateText" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource SecondaryText}" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource SectionCard}" Margin="0,0,10,0">
                                <StackPanel><TextBlock Text="{DynamicResource AverageCpu}" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                    <TextBlock x:Name="DashboardCpuText" Margin="0,7,0,0" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DashboardCpuPeakText" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource SecondaryText}" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel><TextBlock Text="{DynamicResource AverageRam}" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                    <TextBlock x:Name="DashboardRamText" Margin="0,7,0,0" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DashboardRamPeakText" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource SecondaryText}" /></StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Grid.Row="5">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="9"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="{DynamicResource RecentActivity}" FontSize="14" FontWeight="SemiBold" />
                                <Button Content="{DynamicResource ViewSessions}" Click="ViewSessions_Click"
                                        HorizontalAlignment="Right" Padding="10,4" />
                            </Grid>
                            <ListBox Grid.Row="2" x:Name="RecentActivityList" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource PrimaryText}" IsHitTestVisible="False">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,7">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}" Margin="0,2,0,0" FontSize="11"
                                                           Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding Time}" VerticalAlignment="Center" FontSize="11"
                                                       Foreground="{DynamicResource SecondaryText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem>
                    <Grid Margin="32,0,32,24">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="KitSelector" DisplayMemberPath="Name" SelectionChanged="KitSelector_SelectionChanged" Padding="7,5" />
                            <TextBox Grid.Column="2" x:Name="KitNameText" Padding="8,5" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="12,0,0,0">
                                <Button Content="{DynamicResource New}" Click="NewKit_Click" Padding="12,7" Margin="0,0,6,0" />
                                <Button x:Name="SaveKitButton" Content="{DynamicResource Save}" Click="SaveKit_Click" Padding="12,7" Margin="0,0,6,0" />
                                <Button x:Name="ActivateKitButton" Content="{DynamicResource MakeActive}" Click="ActivateKit_Click" Padding="12,7" Margin="0,0,6,0" />
                                <Button x:Name="DeleteKitButton" Content="{DynamicResource Delete}" Click="DeleteKit_Click" Padding="12,7" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SectionCard}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="{DynamicResource CleanMode}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1" Margin="0,5,0,0" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{DynamicResource SecondaryText}" Text="{DynamicResource CleanDescription}" />
                                    <ListBox Grid.Row="3" x:Name="CleanAppsList" DisplayMemberPath="DisplayName"
                                             Background="{DynamicResource InsetBackground}" Foreground="{DynamicResource PrimaryText}" BorderThickness="0" />
                                    <StackPanel Grid.Row="5" Orientation="Horizontal">
                                        <Button x:Name="AddCleanButton" Content="{DynamicResource AddExe}" Click="AddCleanApp_Click" Padding="11,6" Margin="0,0,6,0" />
                                        <Button x:Name="RemoveCleanButton" Content="{DynamicResource Remove}" Click="RemoveCleanApp_Click" Padding="11,6" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="{DynamicResource LaunchApps}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1" Margin="0,5,0,0" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{DynamicResource SecondaryText}" Text="{DynamicResource LaunchDescription}" />
                                    <ListBox Grid.Row="3" x:Name="LaunchAppsList" DisplayMemberPath="DisplayName"
                                             Background="{DynamicResource InsetBackground}" Foreground="{DynamicResource PrimaryText}" BorderThickness="0" />
                                    <StackPanel Grid.Row="5" Orientation="Horizontal">
                                        <Button x:Name="AddLaunchButton" Content="{DynamicResource AddExe}" Click="AddLaunchApp_Click" Padding="11,6" Margin="0,0,6,0" />
                                        <Button x:Name="RemoveLaunchButton" Content="{DynamicResource Remove}" Click="RemoveLaunchApp_Click" Padding="11,6" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem>
                    <Grid Margin="32,0,32,24">
                        <DataGrid x:Name="SessionsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                                  Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource PrimaryText}"
                                  RowBackground="{DynamicResource PanelBackground}" AlternatingRowBackground="{DynamicResource InsetBackground}"
                                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource SessionDate}" Binding="{Binding Date}" Width="145" />
                                <DataGridTextColumn Header="{DynamicResource KitColumn}" Binding="{Binding Kit}" Width="*" />
                                <DataGridTextColumn Header="{DynamicResource SessionDuration}" Binding="{Binding Duration}" Width="105" />
                                <DataGridTextColumn Header="{DynamicResource AverageCpu}" Binding="{Binding AverageCpu}" Width="90" />
                                <DataGridTextColumn Header="{DynamicResource PeakCpu}" Binding="{Binding PeakCpu}" Width="90" />
                                <DataGridTextColumn Header="{DynamicResource AverageRam}" Binding="{Binding AverageRam}" Width="100" />
                                <DataGridTextColumn Header="{DynamicResource PeakRam}" Binding="{Binding PeakRam}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="32,0,32,24" MaxWidth="720" HorizontalAlignment="Left">
                            <Border Style="{StaticResource SectionCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource InterfaceStyle}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource InterfaceStyleDescription}" Margin="0,5,0,16"
                                               Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" />
                                    <UniformGrid Columns="2">
                                        <RadioButton x:Name="CalmStyleChoice" GroupName="VisualStyle" Tag="calm"
                                                     Style="{StaticResource SettingChoice}" Checked="Appearance_Checked">
                                            <StackPanel><TextBlock Text="{DynamicResource CalmStyle}" FontWeight="SemiBold" />
                                                <TextBlock Text="{DynamicResource CalmStyleDescription}" Margin="0,5,0,0"
                                                           Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" /></StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="AggressiveStyleChoice" GroupName="VisualStyle" Tag="aggressive"
                                                     Style="{StaticResource SettingChoice}" Checked="Appearance_Checked">
                                            <StackPanel><TextBlock Text="{DynamicResource AggressiveStyle}" FontWeight="SemiBold" />
                                                <TextBlock Text="{DynamicResource AggressiveStyleDescription}" Margin="0,5,0,0"
                                                           Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" /></StackPanel>
                                        </RadioButton>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SectionCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource ColorTheme}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource ColorThemeDescription}" Margin="0,5,0,16"
                                               Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" />
                                    <UniformGrid Columns="2">
                                        <RadioButton x:Name="DarkThemeChoice" GroupName="ColorTheme" Tag="dark"
                                                     Style="{StaticResource SettingChoice}" Checked="Appearance_Checked">
                                            <StackPanel><TextBlock Text="{DynamicResource DarkTheme}" FontWeight="SemiBold" />
                                                <TextBlock Text="{DynamicResource DarkThemeDescription}" Margin="0,5,0,0"
                                                           Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" /></StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="LightThemeChoice" GroupName="ColorTheme" Tag="light"
                                                     Style="{StaticResource SettingChoice}" Checked="Appearance_Checked">
                                            <StackPanel><TextBlock Text="{DynamicResource LightTheme}" FontWeight="SemiBold" />
                                                <TextBlock Text="{DynamicResource LightThemeDescription}" Margin="0,5,0,0"
                                                           Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" /></StackPanel>
                                        </RadioButton>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource StartupAndData}" FontSize="16" FontWeight="SemiBold" />
                                    <CheckBox x:Name="StartWithWindowsToggle" Margin="0,15,0,0"
                                              Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed"
                                              Foreground="{DynamicResource PrimaryText}">
                                        <TextBlock Text="{DynamicResource StartWithWindows}" FontWeight="SemiBold" />
                                    </CheckBox>
                                    <TextBlock Text="{DynamicResource StartWithWindowsDescription}" Margin="20,5,0,15"
                                               Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" />
                                    <Button Content="{DynamicResource OpenDataFolder}" Click="OpenDataFolder_Click"
                                            HorizontalAlignment="Left" Padding="14,8" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="32,0">
                    <TextBlock x:Name="LiveMetricsText" Text="{DynamicResource MonitoringIdle}" VerticalAlignment="Center"
                               FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Margin="0,1,7,0" Fill="{DynamicResource SecondaryText}" />
                        <TextBlock x:Name="StatusText" Text="{DynamicResource StatusStarting}" FontSize="11"
                                   Foreground="{DynamicResource SecondaryText}" MaxWidth="420" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
