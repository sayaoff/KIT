<Window x:Class="KIT.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KIT Alpha" Width="1060" Height="720" MinWidth="900" MinHeight="620"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource PrimaryText}"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="NavigationItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Padding="14,10" CornerRadius="6" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBackground}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SelectedBackground}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HiddenTabs" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="12,0">
                    <TextBlock Text="KIT" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="ALPHA" Margin="1,2,0,0" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryText}" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <RadioButton x:Name="HomeNavigation" GroupName="Navigation" IsChecked="True"
                                 Style="{StaticResource NavigationItem}" Tag="0"
                                 Content="{DynamicResource HomeTab}" Checked="Navigation_Checked" />
                    <RadioButton x:Name="KitsNavigation" GroupName="Navigation"
                                 Style="{StaticResource NavigationItem}" Tag="1"
                                 Content="{DynamicResource KitsTab}" Checked="Navigation_Checked" />
                    <RadioButton x:Name="SessionsNavigation" GroupName="Navigation"
                                 Style="{StaticResource NavigationItem}" Tag="2"
                                 Content="{DynamicResource SessionsTab}" Checked="Navigation_Checked" />
                </StackPanel>

                <StackPanel Grid.Row="4">
                    <TextBlock Text="{DynamicResource LanguageLabel}" Margin="12,0,0,7" FontSize="11"
                               Foreground="{StaticResource SecondaryText}" />
                    <Button x:Name="LanguageToggleButton" Click="LanguageToggle_Click"
                            HorizontalContentAlignment="Left" Padding="12,8" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="82" />
                <RowDefinition Height="*" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="PageTitle" Margin="32,28,32,0" FontSize="22" FontWeight="SemiBold"
                       Text="{DynamicResource HomeTab}" />

            <TabControl x:Name="MainTabs" Grid.Row="1" Style="{StaticResource HiddenTabs}"
                        Background="Transparent" BorderThickness="0">
                <TabItem>
                    <Grid Margin="32,0,32,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource SectionCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="Counter-Strike 2" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ExecutablePathText" Text="{DynamicResource NoExecutable}" Margin="0,7,0,0"
                                               TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" />
                                    <TextBlock x:Name="ActiveKitText" Margin="0,12,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="SelectExecutableButton" Content="{DynamicResource SelectCs2}"
                                        Click="SelectExecutable_Click" Padding="16,8" VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource SessionActivity}" FontSize="14" FontWeight="SemiBold" />
                            <TextBox Grid.Row="2" x:Name="ActivityText" Text="{DynamicResource NoActivity}" IsReadOnly="True"
                                     Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                     Background="{StaticResource PanelBackground}" Foreground="{StaticResource SecondaryText}"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" />
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem>
                    <Grid Margin="32,0,32,24">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="KitSelector" DisplayMemberPath="Name" SelectionChanged="KitSelector_SelectionChanged" Padding="7,5" />
                            <TextBox Grid.Column="2" x:Name="KitNameText" Padding="8,5" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="12,0,0,0">
                                <Button Content="{DynamicResource New}" Click="NewKit_Click" Padding="12,7" Margin="0,0,6,0" />
                                <Button x:Name="SaveKitButton" Content="{DynamicResource Save}" Click="SaveKit_Click" Padding="12,7" Margin="0,0,6,0" />
                                <Button x:Name="ActivateKitButton" Content="{DynamicResource MakeActive}" Click="ActivateKit_Click" Padding="12,7" Margin="0,0,6,0" />
                                <Button x:Name="DeleteKitButton" Content="{DynamicResource Delete}" Click="DeleteKit_Click" Padding="12,7" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SectionCard}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="{DynamicResource CleanMode}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1" Margin="0,5,0,0" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{StaticResource SecondaryText}" Text="{DynamicResource CleanDescription}" />
                                    <ListBox Grid.Row="3" x:Name="CleanAppsList" DisplayMemberPath="DisplayName"
                                             Background="{StaticResource InsetBackground}" Foreground="{StaticResource PrimaryText}" BorderThickness="0" />
                                    <StackPanel Grid.Row="5" Orientation="Horizontal">
                                        <Button x:Name="AddCleanButton" Content="{DynamicResource AddExe}" Click="AddCleanApp_Click" Padding="11,6" Margin="0,0,6,0" />
                                        <Button x:Name="RemoveCleanButton" Content="{DynamicResource Remove}" Click="RemoveCleanApp_Click" Padding="11,6" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="{DynamicResource LaunchApps}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1" Margin="0,5,0,0" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{StaticResource SecondaryText}" Text="{DynamicResource LaunchDescription}" />
                                    <ListBox Grid.Row="3" x:Name="LaunchAppsList" DisplayMemberPath="DisplayName"
                                             Background="{StaticResource InsetBackground}" Foreground="{StaticResource PrimaryText}" BorderThickness="0" />
                                    <StackPanel Grid.Row="5" Orientation="Horizontal">
                                        <Button x:Name="AddLaunchButton" Content="{DynamicResource AddExe}" Click="AddLaunchApp_Click" Padding="11,6" Margin="0,0,6,0" />
                                        <Button x:Name="RemoveLaunchButton" Content="{DynamicResource Remove}" Click="RemoveLaunchApp_Click" Padding="11,6" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem>
                    <Grid Margin="32,0,32,24">
                        <DataGrid x:Name="SessionsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                                  Background="{StaticResource PanelBackground}" Foreground="{StaticResource PrimaryText}"
                                  RowBackground="{StaticResource PanelBackground}" AlternatingRowBackground="{StaticResource InsetBackground}"
                                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource SessionDate}" Binding="{Binding Date}" Width="145" />
                                <DataGridTextColumn Header="{DynamicResource KitColumn}" Binding="{Binding Kit}" Width="*" />
                                <DataGridTextColumn Header="{DynamicResource SessionDuration}" Binding="{Binding Duration}" Width="105" />
                                <DataGridTextColumn Header="{DynamicResource AverageCpu}" Binding="{Binding AverageCpu}" Width="90" />
                                <DataGridTextColumn Header="{DynamicResource PeakCpu}" Binding="{Binding PeakCpu}" Width="90" />
                                <DataGridTextColumn Header="{DynamicResource AverageRam}" Binding="{Binding AverageRam}" Width="100" />
                                <DataGridTextColumn Header="{DynamicResource PeakRam}" Binding="{Binding PeakRam}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="32,0">
                    <TextBlock x:Name="LiveMetricsText" Text="{DynamicResource MonitoringIdle}" VerticalAlignment="Center"
                               FontSize="11" Foreground="{StaticResource SecondaryText}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Margin="0,1,7,0" Fill="{StaticResource SecondaryText}" />
                        <TextBlock x:Name="StatusText" Text="{DynamicResource StatusStarting}" FontSize="11"
                                   Foreground="{StaticResource SecondaryText}" MaxWidth="420" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
