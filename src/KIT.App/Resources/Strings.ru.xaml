<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:String x:Key="Subtitle">Альфа · Counter-Strike 2</sys:String>
    <sys:String x:Key="StatusStarting">Запуск…</sys:String>
    <sys:String x:Key="StatusNotConfigured">Выберите cs2.exe, чтобы начать отслеживание.</sys:String>
    <sys:String x:Key="StatusWatching">Ожидание запуска · активен Kit «{0}»</sys:String>
    <sys:String x:Key="StatusRunning">CS2 запущена · Kit «{0}»</sys:String>
    <sys:String x:Key="StatusStopped">Отслеживание остановлено.</sys:String>
    <sys:String x:Key="HomeTab">Главная</sys:String>
    <sys:String x:Key="NoExecutable">Исполняемый файл не выбран</sys:String>
    <sys:String x:Key="ActiveKitFormat">Активный Kit: {0}</sys:String>
    <sys:String x:Key="SelectCs2">Выбрать cs2.exe</sys:String>
    <sys:String x:Key="SessionActivity">Журнал сессий</sys:String>
    <sys:String x:Key="NoActivity">Событий пока нет.</sys:String>
    <sys:String x:Key="KitsTab">Киты</sys:String>
    <sys:String x:Key="New">Создать</sys:String>
    <sys:String x:Key="Save">Сохранить</sys:String>
    <sys:String x:Key="MakeActive">Сделать активным</sys:String>
    <sys:String x:Key="Delete">Удалить</sys:String>
    <sys:String x:Key="CleanMode">Чистый режим</sys:String>
    <sys:String x:Key="CleanDescription">Выбранные приложения полностью завершаются при запуске CS2 и открываются снова после игры. Несохранённые данные могут быть потеряны.</sys:String>
    <sys:String x:Key="LaunchApps">Запуск приложений</sys:String>
    <sys:String x:Key="LaunchDescription">Приложения запускаются вместе с CS2 и завершаются после сессии. Уже запущенные приложения KIT не трогает.</sys:String>
    <sys:String x:Key="AddExe">Добавить .exe</sys:String>
    <sys:String x:Key="Remove">Убрать</sys:String>
    <sys:String x:Key="TrayOpen">Открыть KIT</sys:String>
    <sys:String x:Key="TrayExit">Выйти</sys:String>
    <sys:String x:Key="LocateCs2">Укажите Counter-Strike 2</sys:String>
    <sys:String x:Key="SelectApplication">Выберите приложение</sys:String>
    <sys:String x:Key="DeletePrompt">Удалить «{0}»?</sys:String>
    <sys:String x:Key="Cs2ActionError">CS2 нельзя добавить как действие Kit.</sys:String>
    <sys:String x:Key="CleanConfirm">Чистый режим полностью завершит это приложение, если оно останется в системном трее. Несохранённые данные могут быть потеряны. Добавить?</sys:String>
    <sys:String x:Key="CleanConfirmTitle">Добавление в Чистый режим</sys:String>
    <sys:String x:Key="ErrorStart">Не удалось запустить KIT.</sys:String>
    <sys:String x:Key="ErrorExecutable">Не удалось использовать выбранный файл.</sys:String>
    <sys:String x:Key="ErrorCreate">Не удалось создать Kit.</sys:String>
    <sys:String x:Key="ErrorSave">Не удалось сохранить Kit.</sys:String>
    <sys:String x:Key="ErrorActivate">Не удалось активировать Kit.</sys:String>
    <sys:String x:Key="ErrorDelete">Не удалось удалить Kit.</sys:String>
    <sys:String x:Key="DataFolder">Папка данных: {0}</sys:String>
    <sys:String x:Key="NewKit">Новый Kit</sys:String>
    <sys:String x:Key="ActivitySessionStarted">Сессия началась</sys:String>
    <sys:String x:Key="ActivityKitApplied">Kit применён</sys:String>
    <sys:String x:Key="ActivityKitRestored">Kit восстановлен</sys:String>
    <sys:String x:Key="ActivityActionWarning">Предупреждение</sys:String>
    <sys:String x:Key="ActivityRecoveryRestored">Восстановление завершено</sys:String>
    <sys:String x:Key="ActivitySessionEnded">Сессия завершена</sys:String>
</ResourceDictionary>
