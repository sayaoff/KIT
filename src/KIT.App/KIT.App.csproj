<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>KIT</AssemblyName>
    <RootNamespace>KIT.App</RootNamespace>
    <Product>KIT</Product>
    <Description>KIT works around the game, never inside it.</Description>
    <Company>KIT Project</Company>
    <Copyright>Copyright © 2026 KIT Project</Copyright>
    <Version>0.1.0-alpha.1</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <ApplicationIcon>Assets\KIT.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\KIT.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\KIT.Core\KIT.Core.csproj" />
    <ProjectReference Include="..\KIT.Data\KIT.Data.csproj" />
    <ProjectReference Include="..\KIT.Infrastructure.Windows\KIT.Infrastructure.Windows.csproj" />
  </ItemGroup>
</Project>
